# Required — xAI
XAI_API_KEY=xai-...
# Returned once when you register the phone number (webhook.dispatch_signing_secret)
XAI_WEBHOOK_SECRET=whsec_...

# Amber / call behaviour
# Built-in voices include eve, ara, luna, iris, celeste, … (see GET /v1/tts/voices)
XAI_VOICE=eve
DSS_PHONE_NUMBER=+442081941993
# Grant's personal mobile or landline for mid-call transfer (E.164)
GRANT_TRANSFER_NUMBER=+447...
# Where Amber emails leads / messages / callbacks
NOTIFY_TO_EMAIL=grant@example.com
NOTIFY_FROM_EMAIL=amber@drivingschoolsolutions.co.uk

# Email delivery — use ONE of:
# A) POST JSON to a webhook (Zapier / Make / n8n / custom)
EMAIL_WEBHOOK_URL=
# B) SMTP via nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public HTTPS base URL of this Render service (no trailing slash)
PUBLIC_BASE_URL=https://dss-voice-agent.onrender.com

# Optional
PORT=10000
LOG_LEVEL=info
# Directory for JSONL lead/message files (use /data on Render with a disk)
DATA_DIR=./data
# Days to keep call records, leads, and caller-name memory on disk (UK GDPR).
# Call transcripts expire from the call itself. A caller's name is kept until
# this many days after the last call from that number. Website chat leads use
# the same file and the same period. Default 30.
DATA_RETENTION_DAYS=30

# Mirra (website chat). Uses XAI_API_KEY above. Email uses NOTIFY_TO_EMAIL and
# EMAIL_WEBHOOK_URL or SMTP_*, the same as Amber. If neither is set, leads are
# still written to DATA_DIR and email is skipped.
# Text model. Default grok-4.7. Reasoning models default to a slow "high"
# effort; Mirra sends "low" unless you change it.
XAI_CHAT_MODEL=grok-4.7
MIRRA_REASONING_EFFORT=low
# Comma-separated page origins allowed to call the chat. When set, this
# replaces the default (https://drivingschoolsolutions.co.uk and
# https://www.drivingschoolsolutions.co.uk). Include every live origin.
# MIRRA_ALLOWED_ORIGINS=https://drivingschoolsolutions.co.uk,https://www.drivingschoolsolutions.co.uk
# Localhost is allowed as well, for testing, unless this is false.
MIRRA_ALLOW_LOCALHOST=true
# Bearer token for GET /mirra/leads. Leave unset to keep that endpoint closed.
# Generate one with: openssl rand -base64 32
LEADS_READ_TOKEN=
# Optional bounds. Defaults: 16 visitor turns, 1500 characters, 8 chats a
# minute and 30 every 10 minutes, per IP.
# MIRRA_MAX_USER_TURNS=16
# MIRRA_MAX_MESSAGE_CHARS=1500
# MIRRA_RATE_PER_MINUTE=8
# MIRRA_RATE_PER_10_MIN=30
