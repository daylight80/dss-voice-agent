# Required — xAI
XAI_API_KEY=xai-...
# Returned once when you register the phone number (webhook.dispatch_signing_secret)
XAI_WEBHOOK_SECRET=whsec_...

# Amber / call behaviour
# Built-in voices include eve, ara, luna, iris, celeste, … (see GET /v1/tts/voices)
XAI_VOICE=eve
DSS_PHONE_NUMBER=+442081941993
# Grant's personal mobile or landline for mid-call transfer (E.164)
GRANT_TRANSFER_NUMBER=+447...
# Where Amber emails leads / messages / callbacks
NOTIFY_TO_EMAIL=grant@example.com
NOTIFY_FROM_EMAIL=amber@drivingschoolsolutions.co.uk

# Email delivery — use ONE of:
# A) POST JSON to a webhook (Zapier / Make / n8n / custom)
EMAIL_WEBHOOK_URL=
# B) SMTP via nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public HTTPS base URL of this Render service (no trailing slash)
PUBLIC_BASE_URL=https://dss-voice-agent.onrender.com

# Optional
PORT=10000
LOG_LEVEL=info
# Directory for JSONL lead/message files (use /data on Render with a disk)
DATA_DIR=./data
